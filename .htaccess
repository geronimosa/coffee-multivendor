Options -Indexes

<FilesMatch "(^\.|\.(sql|log)(\.gz)?$)">
    Require all denied
</FilesMatch>

RewriteEngine On
RewriteRule ^(?:migrations|scripts)(?:/|$) - [F,L]
RewriteRule ^product/([a-z0-9-]+)/?$ admin/menu.php?slug=$1 [QSA,L]
RewriteRule ^product/([a-z0-9-]+)/new/?$ admin/menu_add.php?slug=$1 [QSA,L]
RewriteRule ^product/([a-z0-9-]+)/([0-9]+)/edit/?$ admin/menu_edit.php?slug=$1&id=$2 [QSA,L]
RewriteRule ^shop/([a-z0-9-]+)/?$ menu.php?slug=$1 [QSA,L]
RewriteRule ^shop/([a-z0-9-]+)/takeaway/?$ menu.php?slug=$1&takeaway=1 [QSA,L]
RewriteRule ^shop/([a-z0-9-]+)/table/([a-f0-9]{32})/?$ menu.php?slug=$1&table_token=$2 [QSA,L]
RewriteRule ^vendor/([a-z0-9-]+)/tables/?$ staff/tables.php?slug=$1 [QSA,L]
RewriteRule ^vendor/([a-z0-9-]+)/reports/?$ staff/reports.php?slug=$1 [QSA,L]
RewriteRule ^vendor/([a-z0-9-]+)/tabs/([0-9]+)/?$ staff/tab.php?slug=$1&id=$2 [QSA,L]
RewriteRule ^vendor/([a-z0-9-]+)/?$ staff/index.php?slug=$1 [QSA,L]
