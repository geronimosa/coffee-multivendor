[Unit]
Description=QRKiosk Edge local storefront
After=network.target qrkiosk-edge-sync.service
Wants=qrkiosk-edge-sync.service

[Service]
Type=simple
User=qrkiosk-edge
Group=qrkiosk-edge
WorkingDirectory=/opt/qrkiosk-edge
Environment=QRKIOSK_EDGE_DATA_DIR=/var/lib/qrkiosk-edge
ExecStart=/usr/bin/gunicorn --workers 2 --threads 4 --bind 0.0.0.0:80 --access-logfile - web:app
Restart=always
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/qrkiosk-edge

[Install]
WantedBy=multi-user.target
